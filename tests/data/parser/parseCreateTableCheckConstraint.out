{
    "query": "CREATE TABLE `t` (\n  `a` int(11) DEFAULT NULL,\n  `b` int(11) DEFAULT NULL CHECK (`b` > 0),\n  CONSTRAINT `chk_ab` CHECK (`a` < `b`),\n  CONSTRAINT CHECK (`a` <> 42),\n  CHECK (`b` != 0xDEAD),\n  CONSTRAINT `chk_not_enforced` CHECK (`a` > 0) NOT ENFORCED,\n  `c` int(11) DEFAULT NULL\n) ENGINE=InnoDB;\n",
