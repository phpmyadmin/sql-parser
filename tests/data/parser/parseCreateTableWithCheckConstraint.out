    "query": "CREATE TABLE table_name (\n  PrimaryKeyId INT UNSIGNED NOT NULL,\n  NextSequence INT UNSIGNED NOT NULL DEFAULT 1,\n  CreatedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  UpdatedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP\n    ON UPDATE CURRENT_TIMESTAMP,\n  PRIMARY KEY (PrimaryKeyId),\n  CONSTRAINT chk_next_sequence CHECK (NextSequence >= 1),\n  CONSTRAINT fk_name FOREIGN KEY (PrimaryKeyId) REFERENCES foreign_table_name (PrimaryKeyId)\n    ON UPDATE CASCADE ON DELETE CASCADE\n) ENGINE=InnoDB;",
