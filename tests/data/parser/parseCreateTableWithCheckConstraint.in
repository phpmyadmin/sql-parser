CREATE TABLE table_name (
  PrimaryKeyId INT UNSIGNED NOT NULL,
  NextSequence INT UNSIGNED NOT NULL DEFAULT 1,
  CreatedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  UpdatedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
    ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (PrimaryKeyId),
  CONSTRAINT chk_next_sequence CHECK (NextSequence >= 1),
  CONSTRAINT fk_name FOREIGN KEY (PrimaryKeyId) REFERENCES foreign_table_name (PrimaryKeyId)
    ON UPDATE CASCADE ON DELETE CASCADE
) ENGINE=InnoDB;